@using TravelAgencyExploreGo.Data.Models.Enums
@model TravelAgencyExploreGo.Web.ViewModels.Home.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="hero">
    <div class="hero-slide active" style="background-image: url('/images/home/greece.png')"></div>
    <div class="hero-slide" style="background-image: url('/images/home/italy.png')"></div>
    <div class="hero-slide" style="background-image: url('/images/home/turkey.png')"></div>

    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1>
            Dream it.<br/>
            <span>Book it.</span><br/>
            Live it.
        </h1>
        <p>Discover amazing destinations and unforgettable experiences with ExploreGo.</p>
        <div class="hero-buttons">
            <a asp-controller="Destinations" asp-action="Index" class="hero-primary">Explore Destination →</a>
            <a asp-controller="Trip" asp-action="Index" class="hero-secondary">Exclusive Deals →</a>
        </div>
    </div>

    <button class="hero-arrow hero-prev" type="button" aria-label="Previous slide">&#10094;</button>
    <button class="hero-arrow hero-next" type="button" aria-label="Next slide">&#10095;</button>

    <div class="hero-dots">
        <button class="hero-dot active" type="button" aria-label="Slide 1"></button>
        <button class="hero-dot" type="button" aria-label="Slide 2"></button>
        <button class="hero-dot" type="button" aria-label="Slide 3"></button>
    </div>
</section>

<section class="explore-section">
    <div class="explore-cards">

        <a asp-controller="Destinations" asp-action="Index" class="explore-card">
            <img src="/images/home/card-capadocia.png" alt="Destinations">

            <div class="explore-card-content">
                <div>
                    <span class="card-subtitle">Explore</span>
                    <h2>Destinations</h2>
                    <p>
                        Explore all countries we offer
                        and find your next adventure.
                    </p>
                </div>
                <span class="card-arrow">➜</span>
            </div>
        </a>

        <a asp-controller="Trip" asp-action="Index" class="explore-card">
            <img src="/images/home/card-germany.png" alt="Exclusive deals">
            <div class="explore-card-content">
                <div>
                    <span class="card-subtitle">Exclusive</span>
                    <h2>Deals</h2>
                    <p>
                        Amazing trips at special prices.
                        Don't miss out!
                    </p>
                </div>
                <span class="card-arrow">➜</span>
            </div>
        </a>

        <a asp-controller="Home" asp-action="Index" class="explore-card">
            <img src="~/images/home/card-spain.png" alt="About Us">
            <div class="explore-card-content">
                <div>
                    <h2>About Us</h2>
                    <p>
                        Learn more about our story
                        and what makes us different.
                    </p>    
                </div>
                <span class="card-arrow">➜</span>
            </div>
        </a>

    </div>
</section>

<section class="deals-section">
    <div class="deals-lines">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="deals-slogan">Dream it. Book it. Live it.</div>

    <div class="deals-header">
        <div>
            <h2>Exclusive Deals</h2>
        </div>
        <a asp-controller="Trip" asp-action="Index" class="deals-view-all">View All Deals →</a>
    </div>

    <div class="deals-grid deals-carousel">
        @foreach(var trip in Model.ExclusiveDeals)
        {
            decimal discount = Math.Round((trip.Price - trip.DiscountPrice!.Value)/ trip.Price * 100);

            <div class="deal-card">
                <div class="deal-image">
                    <img src="@trip.Image1" alt="@trip.Title" />
                </div>

                <div class="deal-content">
                    <p class="deal-location">
                        @trip.Destination.Name, @trip.Destination.Country
                    </p>

                    <h3>@trip.Title</h3>

                    <div class="deal-prices">
                        <span class="old-price">$@trip.Price</span>
                        <span class="new-price">$@trip.DiscountPrice</span>
                    </div>

                    <div class="deal-bottom">
                        <a asp-area="" asp-controller="Trip" asp-action="Index" class="deal-button">Explore Trip →</a>
                        <span class="deal-badge">~@discount%</span>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="reviews-section">
    <h2>What Our Travelers Say</h2>
    <p class="reviews-subtitle">Real stories. Unforgettable journeys.</p>

    <div class="reviews-slider">
        <button class="review-prev" type="button">&#10094;</button>

        <div class="review-content">
            <div class="review-starts">★★★★★</div>

            <p class="review-text" id="reviewText">
                "Our trip to Santorini was absolutely amazing!
                Everything was perfectly organized."
            </p>

            <h3 id="reviewName">Emily Johnson</h3>
            <span id="reviewPlace">Santorini, Greece</span>
        </div>
        <button class="review-next" type="button">&#10095;</button>
    </div>
    <div class="review-dots">
        <span class="review-dot active"></span>
        <span class="review-dot"></span>
        <span class="review-dot"></span>
    </div>
</section>

@if(User.Identity != null && User.Identity.IsAuthenticated)
{
    @if (TempData["BookingSuccess"] != null)
    {
        <p class="booking-success">@TempData["BookingSuccess"]</p>
    }

    @if (TempData["BookingError"] != null)
    {
        <p class="booking-error">@TempData["BookingError"]</p>
    }
    <section class="my-bookings">
        <h2>You @Model.UserName have booked</h2>
        <div class="my-bookings-container">
            @if (Model.MyBookings.Count == 0)
            {
                <p>You dont kave any bookings yet.</p>
            }
            else
            {
                @foreach(var booking in Model.MyBookings)
                {
                    <div class="my-booking-row">
                        <img src="@booking.Trip.Image1" alt="@booking.Trip.Title" />
                        <span class="my-booking-title">@booking.Trip.Title</span>
                        <span>@booking.TotalPrice</span>
                        <span class="my-booking-status">@booking.BookingStatus</span>

                        @if (booking.BookingStatus != BookingStatus.Cancelled && booking.Trip.StartDate > DateTime.UtcNow)
                        {
                            <form asp-area="" asp-controller="Booking" asp-action="Cancel" method="post">

                                <input type="hidden" name="id" value="@booking.Id" />

                                <button type="submit" class="my-booking-delete">🗑</button>
                            </form>
                        }
                    </div>
                }
            }
        </div>
    </section>
}

@section Scripts{
    <script src="~/js/home.js" asp-append-version="true"></script>
}