@model IEnumerable<TravelAgencyExploreGo.Data.Models.Entities.Trip>
@{
    ViewData["Title"] = "Home";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="hero">
    <div class="hero-slide active" style="background-image: url('/images/home/greece.png')"></div>
    <div class="hero-slide" style="background-image: url('/images/home/italy.png')"></div>
    <div class="hero-slide" style="background-image: url('/images/home/turkey.png')"></div>

    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1>
            Dream it.<br/>
            <span>Book it.</span><br/>
            Live it.
        </h1>

        <p>
            Discover amazing destinations
            and unforgettable experiences
            with ExploreGo.
        </p>

        <div class="hero-buttons">
            <a href="#" class="hero-primary">Explore Destination →</a>
            <a href="#" class="hero-secondary">Exclusive Deals →</a>
        </div>
    </div>

    <button class="hero-arrow hero-prev" type="button" aria-label="Previous slide">&#10094;</button>
    <button class="hero-arrow hero-next" type="button" aria-label="Next slide">&#10095;</button>

    <div class="hero-dots">
        <button class="hero-dot active" type="button" aria-label="Slide 1"></button>
        <button class="hero-dot" type="button" aria-label="Slide 2"></button>
        <button class="hero-dot" type="button" aria-label="Slide 3"></button>
    </div>
</section>

<section class="explore-section">
    <div class="explore-cards">

        <a href="#" class="explore-card">
            <img src="/images/home/card-capadocia.png" alt="Destinations">

            <div class="explore-card-content">
                <div>
                    <span class="card-subtitle">Explore</span>
                    <h2>Destinations</h2>
                    <p>
                        Explore all countries we offer
                        and find your next adventure.
                    </p>
                </div>
                <span class="card-arrow">➜</span>
            </div>
        </a>

        <a href="#" class="explore-card">
            <img src="/images/home/card-germany.png" alt="Exclusive deals">
            <div class="explore-card-content">
                <div>
                    <span class="card-subtitle">Exclusive</span>
                    <h2>Deals</h2>
                    <p>
                        Amazing trips at special prices.
                        Don't miss out!
                    </p>
                </div>
                <span class="card-arrow">➜</span>
            </div>
        </a>

        <a href="#" class="explore-card">
            <img src="~/images/home/card-spain.png" alt="About Us">
            <div class="explore-card-content">
                <div>
                    <h2>About Us</h2>
                    <p>
                        Learn more about our story
                        and what makes us different.
                    </p>    
                </div>
                <span class="card-arrow">➜</span>
            </div>
        </a>

    </div>
</section>


@section Scripts{
    <script src="~/js/home.js" asp-append-version="true"></script>
}