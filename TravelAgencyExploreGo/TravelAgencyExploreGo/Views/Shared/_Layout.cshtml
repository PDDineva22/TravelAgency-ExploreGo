<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ExploreGo</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @*Here are the links for the custom font styles*@
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;500;600;700&family=Kalam:wght@300;400;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    @*Allows using more then one CSS or JS file*@
    @*There is no need to specify which CSS and JS file is going to be rendered here*@
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="explore-navbar">
            <a asp-controller="Home" asp-action="Index" class="explore-logo">
                <img src="~/images/exploreGo-logo.png" alt="" class="navbar-logo">   
            </a>

            <div class="explore-links">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a href="#">Destinations</a>
                <a href="#">Exclusive Deals</a>
                <a href="#">About Us</a>
            </div>
            <div class="explore-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="User" asp-action="Logout" method="post">
                        <button type="submit" class="login-btn">Log out</button>
                    </form>
                }
                else
                {
                    <a asp-controller="User" asp-action="Login" class="login-btn">Log in</a>
                    <a asp-controller="User" asp-action="Register" class="register-btn">Register</a>
                }
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="explore-footer">
        <h3>Explore Go</h3>
        <p>Dream it. Book it. Live it.</p>
        <p>&#64; 2026 ExploreGo</p>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
