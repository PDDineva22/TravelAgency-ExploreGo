@model List<TravelAgencyExploreGo.Data.Models.Entities.Destination>
@{
    ViewData["Title"] = "Manage Destinations";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-bookings.css" asp-append-version="true" />
}

<section class="admin-bookings">
    <h1>Manage Destinations</h1>

    <a asp-area="Admin" asp-controller="Destinations" asp-action="Create" class="btn btn-success">Add Destination</a>
    @if (TempData["Error"] != null)
    {
        <p class="text-danger">@TempData["Error"]</p>
    }
    <table class="admin-bookings-table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Country</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var destination in Model)
            {
                <tr>
                    <td>
                        <img src="@destination.ImageUrl" width="70" alt="@destination.Name" />
                    </td>
                    <td>@destination.Name</td>
                    <td>@destination.Country</td>
                    <td>
                        <a asp-area="Admin" asp-controller="Destinations" asp-action="Edit" asp-route-id="@destination.Id" class="btn btn-warning">Edit</a>
                        <form asp-area="Admin" asp-controller="Destinations" asp-action="Delete" method="post" style="display:inline">
                            <input type="hidden" name="id" value="@destination.Id" />
                            <button type="submit" class="btn btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</section>
