@model TravelAgencyExploreGo.Data.Models.Entities.Trip
@using TravelAgencyExploreGo.Data.Models.Entities
@{
    List<Destination> destinations = ViewBag.Destinations;

    string action = "Create";
    string title = "Add Trip";

    if (Model.Id != Guid.Empty)
    {
        action = "Edit";
        title = "Edit Trip";
    }

    ViewData["Title"] = title;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-bookings.css" />
}

<section class="admin-bookings">

    <h1>@title</h1>
    <form asp-area="Admin" asp-controller="Trip" asp-action="@action" method="post">

        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <label>Title</label>
        <input asp-for="Title" class="form-control" />

        <label>Description</label>
        <textarea asp-for="Description" class="form-control"></textarea>

        <label>Destination</label>
        <select asp-for="DestinationId" class="form-control">
        <option value="">Choose destination</option>
            @foreach (var destination in destinations)
            {
                <option value="@destination.Id">@destination.Name</option>
            }
        </select>

        <label>Start Date</label>
        <input asp-for="StartDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />

        <label>End Date</label>
        <input asp-for="EndDate" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" />

        <label>Price</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />

        <label>Discount Price</label>
        <input asp-for="DiscountPrice" type="number" step="0.01" class="form-control" />

        <label>Available Seats</label>
        <input asp-for="AvailableSeats" type="number" class="form-control" />

        <label>Image 1 URL</label>
        <input asp-for="Image1" type="text" class="form-control" />

        <label>Image 2 URL</label>
        <input asp-for="Image2" type="text" class="form-control" />

        <button type="submit" class="btn btn-success mt-3">Save</button>

        <a asp-area="Admin" asp-controller="Trip" asp-action="Index" class="btn btn-secondary mt-3">Back</a>
    </form>
</section>
